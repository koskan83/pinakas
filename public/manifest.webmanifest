{
  "name": "PrismaBoard",
  "short_name": "PrismaBoard",
  "start_url": "./",
  "display": "standalone",
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "files", "accept": ["image/*", "application/pdf", ".png", ".jpg", ".jpeg", ".pdf"] }]
    }
  },
  "background_color": "#ffffff",
  "theme_color": "#1f2937",
  "icons": [
    { "src": "icon-256.png", "sizes": "256x256", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
